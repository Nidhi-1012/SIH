# Database
DATABASE_URL=postgresql://postgres:postgres_secure_password@localhost:5432/ner_link_db
SQLITE_FALLBACK_URL=sqlite:///./data/ner_link.db

# External APIs
# IMD (Indian Meteorological Department) API Key / Endpoint
IMD_API_KEY=
IMD_API_ENDPOINT=https://api.imd.gov.in/v1

# Bhuvan (ISRO Geo-Portal) API Token
BHUVAN_API_KEY=
BHUVAN_TILE_URL=https://bhuvan-vec1.nrsc.gov.in/bhuvan/gwc/service/wmts

# Open-Meteo Weather API (Free fallback, no key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# GraphHopper Routing Engine URL
GRAPHHOPPER_URL=http://localhost:8989

# Security & App Config
SECRET_KEY=ner_link_ai_super_secret_jwt_key_2026
ENVIRONMENT=development
LOG_LEVEL=INFO
