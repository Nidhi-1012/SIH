# Database
DATABASE_URL=postgresql://postgres:postgres_secure_password@localhost:5432/ner_link_db
SQLITE_FALLBACK_URL=sqlite:///./data/ner_link.db

# Supabase (Authentication) — Project Settings -> API on your Supabase dashboard
# SUPABASE_SERVICE_ROLE_KEY is backend-only. Never ship it to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret gating officer self-signup — give to real officers out of band
OFFICER_INVITE_CODE=

# Google Maps JS API (Phase 1 — map surface only; GraphHopper stays the routing
# engine, see CLAUDE.md). Referrer-restrict this key in the GCP console before
# shipping; it is loaded client-side so it is not a true secret either way.
GOOGLE_MAPS_API_KEY=

# External APIs
# IMD (Indian Meteorological Department) API Key / Endpoint
IMD_API_KEY=
IMD_API_ENDPOINT=https://api.imd.gov.in/v1

# Bhuvan (ISRO Geo-Portal) API Token
BHUVAN_API_KEY=
BHUVAN_TILE_URL=https://bhuvan-vec1.nrsc.gov.in/bhuvan/gwc/service/wmts

# Open-Meteo Weather API (Free fallback, no key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# GraphHopper Routing Engine URL
GRAPHHOPPER_URL=http://localhost:8989

# Security & App Config
SECRET_KEY=ner_link_ai_super_secret_jwt_key_2026
ENVIRONMENT=development
LOG_LEVEL=INFO
